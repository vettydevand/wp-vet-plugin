server {
    listen 80;
    server_name _;
    root {{ project_dest }}/wp-vet-plugin/modern-standalone;
    index index.html;

    location / {
        try_files $uri $uri/ =404;
    }

    location ~ \.php$ {
        include snippets/fastcgi-php.conf;
        fastcgi_pass unix:/var/run/php/php7.4-fpm.sock; # Adatta la versione di PHP se necessario
    }
}
